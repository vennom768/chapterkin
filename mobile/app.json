{
  "expo": {
    "name": "ChapterKin",
    "slug": "chapterkin",
    "scheme": "chapterkin",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chapterkin.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ChapterKin uses the camera only if you take a photo to help draw your child. We do not keep the photo.",
        "NSPhotoLibraryUsageDescription": "ChapterKin can use one photo from your library to help draw your child. We do not keep the photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chapterkin.app",
      "adaptiveIcon": {
        "backgroundColor": "#f7f0e4",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "ChapterKin can use one photo to help draw your child. We do not keep the photo.",
          "cameraPermission": "ChapterKin uses the camera only if you take a photo to help draw your child. We do not keep the photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f0e4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63b1058c-944e-4636-b867-d2405c40378c"
      }
    },
    "owner": "mcharrisp"
  }
}
